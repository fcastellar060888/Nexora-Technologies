# Public browser configuration only.
# Every VITE_* value is embedded in the client bundle and MUST be safe to expose publicly.
# Never place Supabase service-role keys, database passwords, private API keys or other secrets here.
VITE_APP_ENV=local
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
