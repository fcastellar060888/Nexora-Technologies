{
  "name": "nexora-one",
  "private": true,
  "version": "7.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:preview": "vite build --mode preview",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "audit:static": "node scripts/static-audit.mjs",
    "audit:deps": "npm audit --audit-level=high",
    "audit:env": "node scripts/audit-environment.mjs",
    "audit:auth": "node scripts/audit-auth-session.mjs",
    "audit:build": "node scripts/audit-production-build.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "check": "npm run audit:static && npm run audit:deps && npm run audit:env && npm run audit:auth && npm run test:coverage && npm run build:production && npm run audit:build"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "6.30.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "7.3.6"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
